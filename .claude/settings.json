{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "network": {
      "allowedDomains": [
        "*.vercel.app"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-docs.sh\"",
            "timeout": 10,
            "statusMessage": "Carregando orientação por assunto..."
          }
        ]
      }
    ]
  }
}
